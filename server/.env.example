PORT=5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Required: MongoDB database connection string.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ecommerce?retryWrites=true&w=majority

# Required: any long random string. Changing this logs out existing users.
JWT_SECRET=replace-with-a-long-random-secret

# Required only for admin product image uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Required only for PayPal checkout.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Visual/image search runs locally and does not need an external API key.
